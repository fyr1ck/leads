# ============================================================
#  HENVIX SALES PANEL - variaveis de ambiente
#  Copie este arquivo para .env e preencha os valores.
#  NUNCA comite o .env. A GROQ_API_KEY nunca vai para o frontend.
# ============================================================

# Porta da API/backend local
PORT=3001

# Porta do painel (frontend Vite) - usada para liberar CORS
WEB_PORT=3000

# Banco de dados local (SQLite via node:sqlite)
DATABASE_URL=file:./data/henvix.db

# ---------------- ACESSO AO PAINEL ----------------
# E-mails que podem entrar (separados por virgula). Qualquer outro e recusado.
# A senha de cada um e criada pela propria pessoa no primeiro acesso.
USUARIOS_PERMITIDOS=joao.jhcc31@gmail.com,castrinvini@gmail.com
# 0 desliga o login (nao recomendado se a porta estiver exposta na rede)
EXIGIR_LOGIN=1
# 1 quando o painel estiver publicado atras de HTTPS (VPS, tunel, dominio).
# Em localhost (http) deixe 0, senao o navegador descarta o cookie de sessao.
COOKIE_SEGURO=0

# ---------------- GROQ (IA) ----------------
# Chave da API Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo que ESCREVE a mensagem de prospeccao
# (confira em https://console.groq.com/docs/models quais estao na sua conta)
GROQ_MODEL=openai/gpt-oss-120b
# Modelo que CLASSIFICA as respostas recebidas.
# Usar um modelo menor aqui separa o limite de tokens por minuto do modelo
# acima - importante no plano gratuito da Groq.
GROQ_MODEL_ANALISE=openai/gpt-oss-20b
# Temperatura da geracao de mensagens (0 = mais previsivel)
GROQ_TEMPERATURE=0.6

# ---------------- SKILL DE VENDAS ----------------
# Caminho do arquivo da Skill Henvix (system prompt da IA)
HENVIX_SKILL_PATH=./skills/Skill_Henvix_atualizada.md

# ---------------- ENCONTRAR LEADS (Google Places) ----------------
# Chave do Google Cloud com "Places API (New)" e "Geocoding API" habilitadas.
# Sem ela a busca de leads fica desativada - o resto do painel funciona normal.
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
# Teto de resultados por busca (a API devolve 20 por pagina, ate 3 paginas)
PLACES_MAX_RESULTADOS=60

# ---------------- WHATSAPP ----------------
# Pasta onde a sessao do WhatsApp Web fica salva (evita novo QR Code)
WA_SESSION_DIR=./data/wa-session
# Nome exibido no aparelho ao conectar
WA_DEVICE_NAME=Henvix Painel

# ---------------- OPERACAO / SEGURANCA ----------------
# Limite diario de mensagens enviadas (0 = sem limite)
LIMITE_DIARIO=200
# Delay entre mensagens (segundos) - intervalo aleatorio
DELAY_MIN=30
DELAY_MAX=90
# Pausa entre blocos: a cada N mensagens, pausar M minutos
BLOCO_TAMANHO=10
BLOCO_PAUSA_MINUTOS=5
# Erros consecutivos que pausam a campanha automaticamente
MAX_ERROS_CONSECUTIVOS=3
# Link de demonstracao usado pela IA (deixe vazio se nao houver)
LINK_DEMONSTRACAO=
