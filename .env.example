# ============================================================
#  HENVIX SALES PANEL - variaveis de ambiente
#  Copie este arquivo para .env e preencha os valores.
#  NUNCA comite o .env. A GROQ_API_KEY nunca vai para o frontend.
# ============================================================

# Porta da API/backend local
PORT=3001

# Porta do painel (frontend Vite) - usada para liberar CORS
WEB_PORT=3000

# Banco de dados local (SQLite via node:sqlite)
DATABASE_URL=file:./data/henvix.db

# ---------------- GROQ (IA) ----------------
# Chave da API Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo usado para gerar mensagens e analisar respostas
GROQ_MODEL=llama-3.3-70b-versatile
# Temperatura da geracao de mensagens (0 = mais previsivel)
GROQ_TEMPERATURE=0.6

# ---------------- SKILL DE VENDAS ----------------
# Caminho do arquivo da Skill Henvix (system prompt da IA)
HENVIX_SKILL_PATH=./skills/Skill_Henvix_atualizada.md

# ---------------- WHATSAPP ----------------
# Pasta onde a sessao do WhatsApp Web fica salva (evita novo QR Code)
WA_SESSION_DIR=./data/wa-session
# Nome exibido no aparelho ao conectar
WA_DEVICE_NAME=Henvix Painel

# ---------------- OPERACAO / SEGURANCA ----------------
# Limite diario de mensagens enviadas (0 = sem limite)
LIMITE_DIARIO=200
# Delay entre mensagens (segundos) - intervalo aleatorio
DELAY_MIN=30
DELAY_MAX=90
# Pausa entre blocos: a cada N mensagens, pausar M minutos
BLOCO_TAMANHO=10
BLOCO_PAUSA_MINUTOS=5
# Erros consecutivos que pausam a campanha automaticamente
MAX_ERROS_CONSECUTIVOS=3
# Link de demonstracao usado pela IA (deixe vazio se nao houver)
LINK_DEMONSTRACAO=
